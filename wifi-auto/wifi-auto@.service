[Unit]
Description=Automatic Wi-Fi on %I
BindsTo=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device

[Service]
ExecStart=/usr/sbin/wpa_supplicant -i %I -c /etc/wpa_supplicant/wifi-nas.conf
ExecStartPost=/usr/sbin/dhclient -nw %I
ExecStopPost=-/usr/sbin/dhclient -x %I
Restart=on-failure

[Install]
WantedBy=multi-user.target
